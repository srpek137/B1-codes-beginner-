      "source": [
        "import matplotlib.pyplot as plt\n",
        "from collections import Counter\n",
        "\n",
        "# Conte a ocorrência de cada base na sequência\n",
        "base_counts = Counter(dna_sequence)\n",
        "\n",
        "# Prepare os dados para o gráfico\n",
        "bases = list(base_counts.keys())\n",
        "counts = list(base_counts.values())\n",
        "\n",
        "# Crie um gráfico de barras para a contagem de bases\n",
        "plt.figure(figsize=(6, 4))\n",
        "plt.bar(bases, counts, color=['lightblue', 'lightgreen', 'salmon', 'orchid'])\n",
        "plt.xlabel('Base')\n",
        "plt.ylabel('Contagem')\n",
        "plt.title('Contagem de Bases na Sequência de DNA')\n",
        "plt.show()"
      ],
