        "import random\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "def gerar_sequencia_dna(comprimento):\n",
        "    \"\"\"\n",
        "    Gera uma sequência de DNA aleatória com o comprimento especificado.\n",
        "\n",
        "    Args:\n",
        "        comprimento: O comprimento desejado para a sequência de DNA.\n",
        "\n",
        "    Returns:\n",
        "        Uma string representando a sequência de DNA aleatória.\n",
        "    \"\"\"\n",
        "    # Define the possible nucleotides\n",
        "    nucleotideos = ['A', 'T', 'C', 'G']\n",
        "    # Generate a random sequence of nucleotides with the specified length\n",
        "    sequencia = ''.join([random.choice(nucleotideos) for _ in range(comprimento)])\n",
        "    return sequencia\n",
        "\n",
        "# Generate the DNA sequence with a length of 100\n",
        "sequencia_dna = gerar_sequencia_dna(100)\n",
        "# Get the length of the generated sequence\n",
        "sequence_length = len(sequencia_dna)\n",
        "\n",
        "# Simulate chromatogram data\n",
        "\n",
        "# Define base intensity values for each nucleotide\n",
        "intensidade_base = {'A': 0.8, 'T': 1.0, 'C': 0.9, 'G': 1.1}\n",
        "# Initialize a dictionary to store the simulated chromatogram data for each nucleotide\n",
        "dados_cromatograma = {'A': [], 'T': [], 'C': [], 'G': []}\n",
        "\n",
        "# Iterate through each nucleotide in the generated DNA sequence\n",
        "for nucleotideo_sequencia in sequencia_dna:\n",
        "    # For each position, simulate intensity for all four bases\n",
        "    for base in ['A', 'T', 'C', 'G']:\n",
        "        # Check if the current base matches the nucleotide in the sequence at this position\n",
        "        if base == nucleotideo_sequencia:\n",
        "            # If it matches, assign a higher intensity with added random noise\n",
        "            intensidade = intensidade_base[base] + np.random.normal(0, 0.1)\n",
        "        else:\n",
        "            # If it doesn't match, assign a lower intensity (10% of base intensity) with added random noise\n",
        "            intensidade = np.random.normal(intensidade_base[base] * 0.1, 0.05)\n",
        "        # Append the simulated intensity to the corresponding base's list, ensuring it's not negative\n",
        "        dados_cromatograma[base].append(max(0, intensidade))\n",
        "\n",
        "# Plot the chromatogram\n",
        "\n",
        "# Create an array for the x-axis values (positions in the sequence)\n",
        "x_values = np.arange(sequence_length)\n",
        "\n",
        "# Create a figure and axes for the plot, adjusting the figure size\n",
        "plt.figure(figsize=(15, 6))\n",
        "\n",
        "# Plot the intensity data for each nucleotide as a line\n",
        "plt.plot(x_values, dados_cromatograma['A'], color='green', label='A')\n",
        "plt.plot(x_values, dados_cromatograma['T'], color='red', label='T')\n",
        "plt.plot(x_values, dados_cromatograma['C'], color='blue', label='C')\n",
        "plt.plot(x_values, dados_cromatograma['G'], color='orange', label='G')\n",
        "\n",
        "# Set labels for the x and y axes\n",
        "plt.xlabel(\"Posição na Sequência\")\n",
        "plt.ylabel(\"Intensidade do Sinal\")\n",
